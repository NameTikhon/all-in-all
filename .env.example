# Настройки можно сохранить в приложении: «Настройки ИИ».
# Ключ остаётся на локальном сервере, в файле .env. Не добавляйте .env в Git.
VISION_PROVIDER=genapi
GENAPI_API_KEY=
GENAPI_MODEL=gpt-6-luna
# Для прямого OpenAI API задайте VISION_PROVIDER=openai и заполните:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Настройки API перечитываются без перезапуска. Для смены порта нужен перезапуск.
PORT=8765
